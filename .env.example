# ─────────────────────────────────────────────────────────────
# Configuration (template — copy to .env and adjust)
# ─────────────────────────────────────────────────────────────
# How config is loaded:
#   • The Lambdas and Glue jobs read only a handful of real env vars.
#   • CONFIG_PATH points to a JSON config file (s3://bucket/key, or a local path).
#   • Everything else lives INSIDE that JSON file — see config/*.example.json,
#     one commented file per component.

# ── real environment variables ──
CONFIG_PATH=
LOG_LEVEL=INFO
# Kill switch for CloudWatch custom metrics (any config value wins over this).
METRICS_ENABLED=true


# ─────────────────────────────────────────────────────────────
# Deployment / Terraform output values
# ─────────────────────────────────────────────────────────────
AWS_REGION=eu-west-3
OUTPUT_BUCKET=

# source ① — the streaming path
QUEUE_URL=
QUEUE_NAME=
QUEUE_ARN=
DLQ_ARN=
LAMBDA_PRODUCER_NAME=
LAMBDA_PROCESSOR_NAME=

# the four Glue jobs, in execution order
GLUE_JOB_BRONZE_TO_SILVER=
GLUE_JOB_QUALITY_AUDIT=
GLUE_JOB_SILVER_TO_GOLD=
GLUE_JOB_RDS_LOAD=

STATE_MACHINE_ARN=
ALERT_TOPIC_ARN=


# ─────────────────────────────────────────────────────────────
# Data lake layout — medallion zones (keys of the JSON config)
# ─────────────────────────────────────────────────────────────
# landing/partners/                 source ② — partner files, exactly as received
# bronze/events/dt=…/hour=…/        sources ① ② — NDJSON, event-time partitioned
# silver/events/partition_date=…/   Parquet event fact table
# gold/<dataset>/                   six analytical tables
# quarantine/…                      records that failed a quality rule, with the reasons
# quality/dt=…/*.json               per-run quality + audit reports
LANDING_PREFIX=landing/
BRONZE_PREFIX=bronze/
SILVER_PREFIX=silver/
GOLD_PREFIX=gold/
QUARANTINE_PREFIX=quarantine/
QUALITY_PREFIX=quality/

# Pre-medallion keys. Still honoured when set — they win over the defaults above,
# so an existing deployment keeps writing exactly where it wrote before.
# RAW_PREFIX=raw/
# PROCESSED_PREFIX=processed/
# CURATED_PREFIX=curated/
# REJECTED_PREFIX=rejected/


# ─────────────────────────────────────────────────────────────
# Source ① — catalog API (producer; see config/ecommerce_producer.example.json)
# ─────────────────────────────────────────────────────────────
# All product sources are merged and deduplicated on product_id; a failing one is skipped.
ECOMMERCE_API_URL=https://api.escuelajs.co/api/v1/products
PRODUCTS_S3_CSV=
PRODUCTS_S3_JSON=
CUSTOMERS_S3_CSV=
CHANNEL=web
CURRENCY=EUR


# ─────────────────────────────────────────────────────────────
# Warehouse — PostgreSQL RDS (the load job; see config/glue_rds_load.example.json)
# ─────────────────────────────────────────────────────────────
# The only database in the pipeline, and it sits at the end of it.
# Prefer the secret; never commit a real password.
RDS_SECRET_ARN=
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=
RDS_SCHEMA=analytics
RDS_USERNAME=
RDS_PASSWORD=
RDS_SSLMODE=require
